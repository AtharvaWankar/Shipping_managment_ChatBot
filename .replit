modules = ["nodejs-20", "python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Start Server"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Chatbot Server"

[[workflows.workflow]]
name = "Chatbot Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m http.server 5000"
waitForPort = 5000

[[workflows.workflow]]
name = "Web Server"
author = 46199693
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m http.server 5000 --bind 0.0.0.0"

[[workflows.workflow]]
name = "Alternative Server"
author = 46199693
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -c \""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "import http.server"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "import socketserver"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "import os"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = ""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT = 5000"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "Handler = http.server.SimpleHTTPRequestHandler"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = ""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "try:"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "    with socketserver.TCPServer(('0.0.0.0', PORT), Handler) as httpd:"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "        print(f'Server running at http://0.0.0.0:{PORT}/')"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "        httpd.serve_forever()"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "except OSError as e:"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "    print(f'Port {PORT} is busy, trying port 8000...')"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "    PORT = 8000"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "    with socketserver.TCPServer(('0.0.0.0', PORT), Handler) as httpd:"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "        print(f'Server running at http://0.0.0.0:{PORT}/')"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "        httpd.serve_forever()"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "\""

[[workflows.workflow]]
name = "Start Chatbot"
author = 46199693
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -c \""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "import http.server"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "import socketserver"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "import os"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = ""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "def start_server(port):"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "    try:"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "        Handler = http.server.SimpleHTTPRequestHandler"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "        with socketserver.TCPServer(('0.0.0.0', port), Handler) as httpd:"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "            print(f'Professional Chatbot running at http://0.0.0.0:{port}/')"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "            print(f'Access your chatbot via the Replit webview or external URL')"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "            httpd.serve_forever()"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "    except OSError as e:"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "        if 'Address already in use' in str(e):"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "            print(f'Port {port} is busy, trying port {port + 1000}...')"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "            return start_server(port + 1000)"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "        else:"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "            raise e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = ""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "start_server(5000)"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "\""

[[workflows.workflow]]
name = "Start Server"
author = 46199693
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m http.server 5000 --bind 0.0.0.0"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000
